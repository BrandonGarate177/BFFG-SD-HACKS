# URL of the teammates' RAG bot API (built on Snowflake) that returns
# reasons/context for a single parcel (called on /parcel-detail).
# Expected request: JSON body — the merged parcel record from parcel_lookup.py
# ({"apn", "parcel": {...}, "capacity": {...}, "predictions": {...}}).
# Expected response: {"reasons": [string, ...], "sentiment_summary": string}
# If unset, rag_client.py falls back to a deterministic mock response.
RAG_API_URL=

# URL of the ML model's bulk-ingest endpoint. Receives a JSON body
# {"records": [...]} — one object per parcel, keyed by the DSD
# projects/approvals column names (see csv_export.py for the exact headers).
# No file upload; it's a plain JSON POST.
# Expected response: {"status": string, "rows_received": number}
# If unset, ml_bulk_client.py falls back to a mock acknowledgement.
ML_MODEL_BULK_URL=
