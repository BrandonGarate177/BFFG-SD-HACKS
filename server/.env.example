# URL of the ML model API that re-confirms/refines the time+cost prediction
# for a single parcel (called on /parcel-detail).
# Expected request: JSON parcel attributes (see sample_parcels.geojson properties)
# Expected response: {"predicted_time_months": number, "predicted_cost_usd": number}
# If unset, ml_model_client.py falls back to a deterministic mock prediction.
ML_MODEL_URL=

# URL of the teammates' RAG bot API (built on Snowflake) that returns
# reasons/context for a single parcel (called on /parcel-detail).
# Expected request: JSON parcel attributes (see sample_parcels.geojson properties)
# Expected response: {"reasons": [string, ...], "sentiment_summary": string}
# If unset, rag_client.py falls back to a deterministic mock response.
RAG_API_URL=
